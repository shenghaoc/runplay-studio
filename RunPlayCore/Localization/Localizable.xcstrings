          }
        }
      }
    },
    "The model has no load for those days and decays as if you had rested, so that stretch reads as lost fitness and gained freshness." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型中这些天没有负荷，曲线会像你在休息一样衰减，因此这段时间会显示为体能下降、状态回升。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型中這些天沒有負荷，曲線會像你在休息一樣衰減，因此這段期間會顯示為體能下降、狀態回升。"
          }
        }
      }
    },
    "The recorded barometric altitude is kept wherever it exists." : {
