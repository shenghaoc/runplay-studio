    "%@  ·  Output %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  Output %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  输出 %2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  輸出 %2$@"
          }
        }
      }
    },
    "%@ Alignment" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对齐方式：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對齊方式：%@"
          }
        }
      }
    },
    "%@ is damaged: its contents do not match the checksum the archive records." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已损坏：其内容与存档记录的校验和不一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已損毀：其內容與封存檔記錄的檢查碼不一致。"
          }
        }
      }
    },
    "%@ is larger than the %@ limit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is larger than the %2$@ limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 超过 %2$@ 的大小限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 超過 %2$@ 的大小限制。"
          }
        }
      }
    },
    "%lld candidates exceed the total archive import size limit." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld candidate exceeds the total archive import size limit."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld candidates exceed the total archive import size limit."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个候选活动超出存档导入的总大小限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個候選活動超出封存檔匯入的總大小限制。"
          }
        }
      }
    },
    "%lld route files in the archive match %@ when letter case is ignored, so none of them is read." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld route files in the archive match %2$@ when letter case is ignored, so none of them is read."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略大小写后，存档中有 %1$lld 个路线文件与 %2$@ 匹配，因此都不会被读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略大小寫後，封存檔中有 %1$lld 個路線檔案與 %2$@ 相符，因此都不會被讀取。"
          }
        }
      }
    },
