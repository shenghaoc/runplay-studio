            "state" : "translated",
            "value" : "此路線已不存在。請重新分群或選擇其他路線。"
          }
        }
      }
    },
    "This run currently holds the whole-library %@ record. Runs whose records were later beaten show no badge; their history is in the Records workspace." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
