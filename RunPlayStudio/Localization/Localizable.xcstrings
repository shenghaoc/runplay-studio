        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日 TRIMP 以及体能、疲劳和状态模型。体能和疲劳是每日负荷的指数加权平均值；状态等于体能减去疲劳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
