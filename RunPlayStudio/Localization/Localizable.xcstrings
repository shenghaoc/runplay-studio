      }
    },
    "This profile is stored only on this Mac, beside your workout library. RunPlay Studio has no accounts, no cloud, and no telemetry." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此运动员档案仅存储在这台 Mac 上你的运动资料库旁边。RunPlay Studio 没有账户、没有云端，也没有遥测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此運動員檔案僅儲存在這台 Mac 上你的運動資料庫旁。RunPlay Studio 沒有帳號、沒有雲端，也沒有遙測。"
          }
        }
      }
    },
    "This route no longer exists. Re-cluster or pick another route." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
