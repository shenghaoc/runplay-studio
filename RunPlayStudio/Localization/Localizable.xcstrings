          }
        }
      }
    },
    "A folder of Terrarium PNG elevation tiles in z/x/y.png layout that you downloaded yourself, such as the free AWS Terrain Tiles. RunPlay Studio only reads it and never downloads tiles. Zoom 13 or 14 suits running." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个包含你自行下载的 Terrarium PNG 海拔瓦片的文件夹，采用 z/x/y.png 目录结构，例如免费的 AWS Terrain Tiles。RunPlay Studio 只会读取该文件夹，绝不会下载瓦片。缩放级别 13 或 14 适合跑步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個包含你自行下載的 Terrarium PNG 海拔圖磚的檔案夾，採用 z/x/y.png 目錄結構，例如免費的 AWS Terrain Tiles。RunPlay Studio 只會讀取該檔案夾，絕不會下載圖磚。縮放層級 13 或 14 適合跑步。"
          }
        }
      }
